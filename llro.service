[Unit]
Description=Lowest Latency Routes Optimizer
After=network.target
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
SyslogIdentifier=LLRO
# Verify the executable path matches your installation (`which llro`).
ExecStart=/usr/local/bin/llro --config /etc/llro.yml --systemd-logging
User=llro
Group=llro
KillMode=process
Restart=always
RestartSec=5s

# Capability sandboxing
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Filesystem sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

# Runtime directory for admin socket
RuntimeDirectory=llro
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
